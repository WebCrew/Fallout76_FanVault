{
  "name": "fanvault-client",
  "version": "0.5.0-step9",
  "description": "FanVault companion overlay for Fallout 76",
  "author": "WebCrew",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "test:local-server": "node local-server.test.js",
    "test:config": "node --test core/runtime-config.test.js core/startup.test.js",
    "test:chat": "node --test core/sngine5-chat.test.js"
  },
  "dependencies": {
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "de.nettwin.fanvault",
    "productName": "FanVault",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "app.js",
      "index.html",
      "local-server.js",
      "main.js",
      "preload.js",
      "style.css",
      "package.json",
      "core/runtime-config.js",
      "games/fallout76.js",
      "core/sngine5-chat.js",
      "core/message-view.js",
      "core/nettwin-login.js"
    ],
    "win": {
      "artifactName": "FanVault-${version}-portable.${ext}",
      "target": "portable"
    }
  }
}
